# Copy to backend/.env on the server (the backend loads .env from its own folder).

PORT=3001
NODE_ENV=production

# TLS — used whenever NODE_ENV is not "development" (defaults shown).
SSL_CERT_PATH=/etc/ssl/cs/CSB.crt
SSL_KEY_PATH=/etc/ssl/cs/myserver.key

# CORS / cookie origin — the public URL the browser hits.
# In the single-server pm2 deploy the frontend is served by the backend,
# so this is that same origin (e.g. https://your-domain.com).
FRONTEND_URL=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/gymbro

# Auth
JWT_SECRET=replace-with-a-long-random-string
REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-string

# Google OAuth
GOOGLE_CLIENT_ID=139144836250-bqmuub6b52eah4f62v7o7j30dn1oh8f3.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=139144836250-bqmuub6b52eah4f62v7o7j30dn1oh8f3.apps.googleusercontent.com

# External pose-estimation service (falls back to a stub adapter when unset)
VIDEO_ANALYSIS_SERVICE_URL=
VIDEO_ANALYSIS_API_KEY=
VIDEO_ANALYSIS_TIMEOUT_MS=120000

# Authenticated Ollama-style LLM used for workout-plan generation
LLM_BASE_URL=http://10.10.248.41
LLM_USERNAME=student1
LLM_PASSWORD=pass123
LLM_MODEL=llama3.1:8b
LLM_TIMEOUT=30
LLM_MAX_RETRIES=3

# RAG retrieval — embeddings are served by the same authenticated LLM host
# (POST /api/embed) using the LLM_* credentials above.
# Run `npm run rag:ingest` from backend/ after changing either value.
EMBEDDING_MODEL=all-minilm
EMBEDDING_DIM=384

# Offline AI-plan evaluation runner (never commit the real password)
AI_PLAN_API_BASE_URL=http://localhost:3001
AI_PLAN_TEST_EMAIL=ai.plan.tester@gymbro.test
AI_PLAN_TEST_PASSWORD=replace-with-a-test-only-password
AI_PLAN_ENVIRONMENT_ID=weak-computer-local
AI_PLAN_PROVIDER=ollama-compatible
